    {"name": "Fideos Matarazzo spaghetti 500 g", "query": "fideos matarazzo", "require": ["matarazzo"], "any": ["spaghetti", "espagueti", "spaghettis", "spagueti"], "exclude": ["integral", "spaghettini", "vegetal"], "size": [500, "g"]},
